# Docker Desktop Pro example configuration
# Copy to a local ignored .env file and replace every placeholder locally.

PROJECT_ID=example-project
REGION=us-central1
ENV=production

PHI_MODE=DEMO
AUTHORITY_LEVEL=1
SOVEREIGNTY_LEVEL=1/9

CPU_CORES=2
GPU_ENABLED=false
NVIDIA_VISIBLE_DEVICES=none
CUDA_VISIBLE_DEVICES=

POSTGRES_DB=dominion_demo
POSTGRES_USER=demo_user
POSTGRES_PASSWORD=change_this_secure_password
POSTGRES_HOST=database
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data/pgdata

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_MEMORY=128mb

FLASK_APP=command_core:app
FLASK_ENV=production
SECRET_KEY=change_this_to_a_random_secret_key
DEBUG=false

OAUTH_CLIENT_ID=your_oauth_client_id
OAUTH_CLIENT_SECRET=your_oauth_client_secret
JWT_SECRET_KEY=change_this_jwt_secret

GRAFANA_PASSWORD=change_this_grafana_password
PROMETHEUS_RETENTION=1d

GCP_PROJECT_ID=example-project
GCP_REGION=us-central1
GCP_SERVICE_ACCOUNT_KEY_PATH=/secrets/gcp-key.json

LOG_LEVEL=WARNING
LOG_FORMAT=json
HSTS_ENABLED=true
CSP_ENABLED=true
SECURE_HEADERS=true

GUNICORN_WORKERS=1
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
GUNICORN_KEEPALIVE=5

BIMS_ENABLED=false
ENABLE_AI_ORCHESTRATION=false
ENABLE_GPU_ACCELERATION=false
ENABLE_SOVEREIGN_MAX=false
ENABLE_PHASE_2_5=false
