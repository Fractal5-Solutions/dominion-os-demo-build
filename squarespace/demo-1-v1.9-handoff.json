{
  "schema": "f5.squarespace.handoff.v1",
  "page": "/demo-1",
  "build": "demo-1-v1.9-20260927-hardened-four-provider-gates",
  "source": "squarespace/demo-1-final.html",
  "deploymentUnit": "single Squarespace code block",
  "publicationAuthority": "Principal manual Squarespace publish",
  "publicDownloadsAvailableNow": false,
  "providerFamilies": [
    "gcp",
    "aws",
    "azure",
    "oci"
  ],
  "activationRequires": [
    "common Windows payload publicDownloadCertified=true",
    "common Authenticode state VERIFIED",
    "common lifecycleAcceptance=PASS",
    "common defenderScan=PASS",
    "claimControl.binaryDownloadEnabled=true",
    "provider package publicDownloadCertified=true",
    "provider package Business mission and Politics excluded",
    "provider package HTTPS URL",
    "provider package SHA-256",
    "public release catalog publicDownloadCertified=true",
    "catalog Business mission and Politics excluded",
    "catalog URL exactly matches provider manifest URL",
    "catalog checksum exactly matches provider package SHA-256"
  ]
}
